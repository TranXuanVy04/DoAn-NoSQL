# Copy to .env and fill in your own Atlas URI and admin password.
Mongo__ConnectionString=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
Mongo__Database=ecommerce_dev
Admin__Username=admin
Admin__Password=

# Local visual demo only; Production always uses MongoDB.
Storefront__UseDemoData=false
