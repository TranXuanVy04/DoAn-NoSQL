@{ ViewData["Title"] = "Liên hệ"; }
<partial name="_StorefrontBreadcrumb" />
<section class="contact spad"><div class="container"><div class="row">
    <div class="col-lg-3 col-md-6"><div class="contact__widget"><span class="icon_phone"></span><h4>Điện thoại</h4><p>1900 0000</p></div></div>
    <div class="col-lg-3 col-md-6"><div class="contact__widget"><span class="icon_pin_alt"></span><h4>Địa chỉ</h4><p>TP. Hồ Chí Minh, Việt Nam</p></div></div>
    <div class="col-lg-3 col-md-6"><div class="contact__widget"><span class="icon_clock_alt"></span><h4>Giờ hỗ trợ</h4><p>08:00 – 20:00 mỗi ngày</p></div></div>
    <div class="col-lg-3 col-md-6"><div class="contact__widget"><span class="icon_mail_alt"></span><h4>Email</h4><p>hello@example.com</p></div></div>
</div><p class="ec-demo-note text-center">Thông tin liên hệ minh họa — sẽ cập nhật sau.</p></div></section>
<section class="contact-form spad"><div class="container"><div class="contact__form__title"><h2>Gửi lời nhắn cho chúng tôi</h2></div>
    <form data-demo-form="Biểu mẫu đang ở chế độ minh họa. Chưa gửi hoặc lưu lời nhắn."><div class="row">
        <div class="col-lg-6"><label class="sr-only" for="contact-name">Họ tên</label><input id="contact-name" placeholder="Họ và tên" required maxlength="100" /></div>
        <div class="col-lg-6"><label class="sr-only" for="contact-email">Email</label><input id="contact-email" type="email" placeholder="Email của bạn" required /></div>
        <div class="col-lg-12 text-center"><label class="sr-only" for="contact-message">Lời nhắn</label><textarea id="contact-message" placeholder="Bạn cần hỗ trợ điều gì?" required maxlength="2000"></textarea><button type="submit" class="site-btn">GỬI LỜI NHẮN</button></div>
    </div></form>
</div></section>
