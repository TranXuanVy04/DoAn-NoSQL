@model List<Category>
@{ ViewData["Title"] = "Danh mục"; }
<div class="section-head">
    <h1>Quản lý danh mục</h1>
    <a class="button" asp-action="CategoryEdit">+ Thêm danh mục</a>
</div>
<div class="table-wrap">
<table>
    <thead><tr><th>Tên</th><th>Danh mục cha</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var category in Model)
    {
        var parent = Model.FirstOrDefault(x => x.Id == category.ParentId);
        <tr>
            <td>@category.Name</td>
            <td>@(parent?.Name ?? "Danh mục gốc")</td>
            <td>
                <a asp-action="CategoryEdit" asp-route-id="@category.Id">Sửa</a>
                <form asp-action="CategoryDelete" method="post" class="inline">
                    <input type="hidden" name="id" value="@category.Id" />
                    <button class="text-button">Xóa danh mục rỗng</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
