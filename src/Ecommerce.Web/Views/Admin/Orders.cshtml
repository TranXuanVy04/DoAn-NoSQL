@model OrderPage
@{ViewData["Title"]="Quản lý đơn hàng";}
<h1>Đơn hàng</h1><form method="get" class="filters"><label>Trạng thái<select name="status"><option value="">Tất cả</option>@foreach(var s in new[]{"Pending","Completed","Cancelled"}){<option value="@s" selected="@(s==(string?)ViewBag.Status)">@s</option>}</select></label><button>Lọc đơn</button></form><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Ngày (UTC+7)</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var o in Model.Items){<tr><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">@o.Number</a></td><td>@o.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td>@o.Customer.Name</td><td>@o.Total.ToString("N0") ₫</td><td><span class="badge">@o.Status</span></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="5">Không có đơn hàng.</td></tr>}</tbody></table></div><nav class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-status="@ViewBag.Status">← Trước</a>}<span>Trang @Model.Page / @Model.Pages · @Model.Total đơn</span>@if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)" asp-route-status="@ViewBag.Status">Tiếp →</a>}</nav>
