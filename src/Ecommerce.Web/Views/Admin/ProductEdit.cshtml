@model ProductForm
@{ViewData["Title"]=Model.Id is null?"Thêm sản phẩm":"Sửa sản phẩm";var cats=(List<Category>)ViewBag.Categories;}
<a class="back" asp-action="Products">← Quản lý sản phẩm</a><h1>@ViewData["Title"]</h1><form method="post" class="panel form-wide"><div asp-validation-summary="All" class="alert validation"></div><input asp-for="Id" type="hidden"/><input asp-for="OriginalStock" type="hidden"/><label asp-for="Sku">SKU</label><input asp-for="Sku" required maxlength="40"/><label asp-for="Name">Tên sản phẩm</label><input asp-for="Name" required maxlength="160"/><label asp-for="CategoryId">Danh mục</label><select asp-for="CategoryId" required><option value="">Chọn danh mục</option>@foreach(var c in cats){<option value="@c.Id">@c.Name</option>}</select><div class="two-col"><div><label asp-for="Price">Giá (VND)</label><input asp-for="Price" type="number" min="1" max="1000000000000" required/></div><div><label asp-for="Stock">Tồn kho</label><input asp-for="Stock" type="number" min="0" max="1000000" required/></div></div><label class="check"><input asp-for="IsActive"/> Đang bán</label><label asp-for="AttributesJson">Thuộc tính theo ngành (JSON)</label><textarea asp-for="AttributesJson" rows="7" maxlength="6000" required spellcheck="false"></textarea><details><summary>Ví dụ thuộc tính</summary><p>Điện tử: <code>{"brand":"Demo","warrantyMonths":12,"ramGB":8}</code></p><p>Thời trang: <code>{"size":"M","material":"Cotton","color":"Đen"}</code></p><p>Gia dụng: <code>{"material":"Inox","origin":"Việt Nam","capacityLiters":2}</code></p></details><button>Lưu sản phẩm</button></form>
