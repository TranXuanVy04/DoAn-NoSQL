@model DashboardView
@{ViewData["Title"]="Dashboard";var revenue=Model.Revenue.Sum(x=>x.Revenue);var count=Model.Revenue.Sum(x=>x.Orders);var peak=Math.Max(1,Model.Revenue.Select(x=>x.Revenue).DefaultIfEmpty(0).Max());}
<p class="eyebrow">TỔNG QUAN KINH DOANH</p><h1>Dashboard</h1><p class="muted">Đơn Completed · Theo ngày tạo đơn · Múi giờ UTC+7</p><form method="get" class="filters"><label>Từ ngày<input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" required/></label><label>Đến hết ngày<input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" required/></label><label>Nhóm theo<select name="group"><option value="day" selected="@(Model.Group=="day")">Ngày</option><option value="month" selected="@(Model.Group=="month")">Tháng</option></select></label><button>Xem báo cáo</button></form><div class="metrics"><article><p>Doanh thu</p><strong id="revenue-total" data-value="@revenue">@revenue.ToString("N0") ₫</strong></article><article><p>Đơn hoàn tất</p><strong id="order-count" data-value="@count">@count</strong></article><article><p>Giá trị đơn trung bình</p><strong>@(count==0?"0":(revenue/count).ToString("N0")) ₫</strong></article></div>
<section class="panel"><h2>Doanh thu theo @(Model.Group=="day"?"ngày":"tháng")</h2>@if(Model.Revenue.Count==0){<p class="empty">Không có doanh thu trong khoảng đã chọn.</p>}else{<div class="chart" role="img" aria-label="Biểu đồ doanh thu; dữ liệu chính xác trong bảng bên dưới">@foreach(var r in Model.Revenue){var height=(100m*r.Revenue/peak).ToString("0.###",CultureInfo.InvariantCulture);<div class="bar-column"><span class="bar" style="height:@(height)%" title="@r.Period: @r.Revenue.ToString("N0") VND"></span><small>@r.Period</small></div>}</div><div class="table-wrap"><table><thead><tr><th>Kỳ</th><th>Doanh thu</th><th>Số đơn</th></tr></thead><tbody>@foreach(var r in Model.Revenue){<tr><td>@r.Period</td><td>@r.Revenue.ToString("N0") ₫</td><td>@r.Orders</td></tr>}</tbody></table></div>}</section>
<section class="panel"><h2>Top 5 sản phẩm bán chạy</h2><p class="muted">Xếp theo số lượng; hòa thì theo doanh thu, sau đó mã sản phẩm.</p><div class="table-wrap"><table id="top-products"><thead><tr><th>#</th><th>Sản phẩm (tên trong snapshot gần nhất)</th><th>Số lượng bán</th><th>Doanh thu</th></tr></thead><tbody>@for(var i=0;i<Model.Top.Count;i++){var p=Model.Top[i];<tr data-product="@p.ProductId"><td>@(i+1)</td><td>@p.Name</td><td class="quantity">@p.Quantity</td><td>@p.Revenue.ToString("N0") ₫</td></tr>}@if(Model.Top.Count==0){<tr><td colspan="4">Chưa có dữ liệu.</td></tr>}</tbody></table></div></section>
