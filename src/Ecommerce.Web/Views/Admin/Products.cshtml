@model ProductPage
@{ViewData["Title"]="Quản lý sản phẩm";var cats=(List<Category>)ViewBag.Categories;}
<div class="section-head"><h1>Quản lý sản phẩm</h1><a class="button" asp-action="ProductEdit">+ Thêm sản phẩm</a></div><form method="get" class="filters"><label>Tìm tên<input name="q" value="@ViewBag.Query"/></label><label>Danh mục<select name="categoryId"><option value="">Tất cả</option>@foreach(var c in cats){<option value="@c.Id" selected="@(c.Id==(string?)ViewBag.CategoryId)">@c.Name</option>}</select></label><button>Lọc</button></form>
<div class="table-wrap"><table><thead><tr><th>SKU / Tên</th><th>Ngành</th><th>Giá</th><th>Tồn</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model.Items){<tr><td>@p.Sku<br/><strong>@p.Name</strong></td><td>@p.Kind</td><td>@p.Price.ToString("N0") ₫</td><td>@p.Stock</td><td>@(p.IsActive?"Đang bán":"Ngừng bán")</td><td><a asp-action="ProductEdit" asp-route-id="@p.Id">Sửa</a> <form method="post" asp-action="ProductDelete" class="inline"><input type="hidden" name="id" value="@p.Id"/><button class="text-button">Ngừng bán</button></form></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="6">Không có sản phẩm.</td></tr>}</tbody></table></div>
<nav class="pagination">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-q="@ViewBag.Query" asp-route-categoryId="@ViewBag.CategoryId">← Trước</a>}<span>Trang @Model.Page / @Model.Pages · @Model.Total sản phẩm</span>@if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)" asp-route-q="@ViewBag.Query" asp-route-categoryId="@ViewBag.CategoryId">Tiếp →</a>}</nav>
