@model StorefrontHeaderViewModel
<div class="humberger__menu__overlay"></div>
<div class="humberger__menu__wrapper" id="category-menu" tabindex="-1" aria-label="Chọn danh mục">
    <button type="button" class="ec-mobile-close" aria-label="Đóng menu"><i class="fa fa-times" aria-hidden="true"></i></button>
    <div class="humberger__menu__logo"><a class="ec-logo" asp-controller="Catalog" asp-action="Index">EC<span>MARKET</span><b>.</b></a></div>
    <div class="humberger__menu__cart">
        <ul><li><a asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng"><i class="fa fa-shopping-bag" aria-hidden="true"></i><span>@Model.CartQuantity</span></a></li></ul>
    </div>
    <nav class="humberger__menu__nav mobile-menu" aria-label="Điều hướng điện thoại"><partial name="_StorefrontMenu" /></nav>
    <div id="mobile-menu-wrap"></div>
    <a class="ec-orders-link" asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a>
    <div class="ec-mobile-categories">
        <h6>Danh mục sản phẩm</h6>
        <a asp-controller="Catalog" asp-action="Shop">Tất cả sản phẩm</a>
        <partial name="_CategoryTree" model="Model.Categories.ToList()" />
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a class="ec-account-link" asp-controller="Admin" asp-action="Dashboard"><i class="fa fa-user" aria-hidden="true"></i> Quản trị</a>
    }
    else
    {
        <a class="ec-account-link" asp-controller="Account" asp-action="Login"><i class="fa fa-user" aria-hidden="true"></i> Đăng nhập</a>
    }
</div>
@if (ViewData["ImmersiveHome"] as bool? == true || ViewData["CategoryShop"] as bool? == true)
{
    <header class="ec-editorial-header">
        <div class="ec-editorial-brand">
            <button class="humberger__open" type="button" aria-label="Mở menu danh mục" aria-controls="category-menu" aria-expanded="false"><i class="fa fa-bars" aria-hidden="true"></i></button>
            <a class="ec-editorial-logo" asp-controller="Catalog" asp-action="Index">EC<span>MARKET</span></a>
        </div>
        <form class="ec-editorial-search" asp-controller="Catalog" asp-action="Shop" method="get" role="search">
            <label class="sr-only" for="header-search">Tìm sản phẩm</label>
            <input id="header-search" name="q" placeholder="Bạn đang tìm kiếm gì?" maxlength="100" required data-search-query />
            <button type="submit" aria-label="Tìm kiếm"><i class="fa fa-search" aria-hidden="true"></i></button>
        </form>
        <div class="ec-editorial-actions">
            <a asp-controller="Orders" asp-action="Index" aria-label="Đơn hàng của tôi" title="Đơn hàng của tôi"><i class="fa fa-file-text-o" aria-hidden="true"></i></a>
            <a href="@(User.IsInRole("Admin") ? Url.Action("Dashboard", "Admin") : Url.Action("Login", "Account"))" aria-label="@(User.IsInRole("Admin") ? "Quản trị" : "Đăng nhập")"><i class="fa fa-user-o" aria-hidden="true"></i></a>
            <a asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng"><i class="fa fa-shopping-bag" aria-hidden="true"></i><span>@Model.CartQuantity</span></a>
        </div>
    </header>
}
else
{
<header class="header">
    <div class="container ec-header-container">
        <div class="row align-items-center">
            <div class="col-lg-3"><div class="header__logo"><a class="ec-logo" asp-controller="Catalog" asp-action="Index">EC<span>MARKET</span><b>.</b></a></div></div>
            <div class="col-lg-7"><nav class="header__menu" aria-label="Điều hướng chính"><partial name="_StorefrontMenu" /></nav></div>
            <div class="col-lg-2">
                <div class="header__cart">
                    <ul>
                        <li><a asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng"><i class="fa fa-shopping-bag" aria-hidden="true"></i><span>@Model.CartQuantity</span></a></li>
                    </ul>
                    <div class="header__cart__price ec-header-account">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Dashboard"><i class="fa fa-user" aria-hidden="true"></i> Quản trị</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"><i class="fa fa-user" aria-hidden="true"></i> Đăng nhập</a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <button class="humberger__open" type="button" aria-label="Mở menu" aria-expanded="false"><i class="fa fa-bars" aria-hidden="true"></i></button>
    </div>
</header>

}
