@model CartView
@{ViewData["Title"]="Giỏ hàng";}
<p class="eyebrow">LỰA CHỌN CỦA BẠN</p><h1>Giỏ hàng</h1>
@if(Model.Rows.Count==0){<div class="empty"><h2>Giỏ hàng đang trống</h2><a class="button" asp-controller="Catalog" asp-action="Index">Bắt đầu mua sắm</a></div>}
else{<div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Đơn giá hiện tại</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td><a asp-controller="Catalog" asp-action="Details" asp-route-id="@row.Product.Id">@row.Product.Name</a>@if(!row.Product.IsActive || row.Product.Stock<row.Quantity){<p class="field-validation-error">Ngừng bán hoặc không đủ tồn kho</p>}</td><td>@row.Product.Price.ToString("N0") ₫</td><td><form asp-action="Update" method="post" class="inline"><input type="hidden" name="productId" value="@row.Product.Id"/><input type="number" aria-label="Số lượng @row.Product.Name" name="quantity" value="@row.Quantity" min="1" max="99"/><button class="small">Cập nhật</button></form></td><td>@row.Total.ToString("N0") ₫</td><td><form asp-action="Update" method="post"><input type="hidden" name="productId" value="@row.Product.Id"/><input type="hidden" name="quantity" value="0"/><button class="text-button">Bỏ</button></form></td></tr>}</tbody></table></div><div class="checkout-summary"><p>Tổng tạm tính <strong>@Model.Total.ToString("N0") ₫</strong></p><p class="muted">Giá và tồn kho được kiểm tra lại khi đặt hàng.</p><a class="button" asp-action="Checkout">Tiếp tục thanh toán →</a></div>}
