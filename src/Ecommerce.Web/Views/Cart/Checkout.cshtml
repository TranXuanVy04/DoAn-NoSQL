@model CheckoutForm
@{ViewData["Title"]="Thanh toán";var cart=(CartView)ViewBag.Cart;}
<a class="back" asp-action="Index">← Giỏ hàng</a><h1>Thông tin nhận hàng</h1><div class="detail-grid"><form method="post" class="panel"><div asp-validation-summary="All" class="alert validation"></div><input asp-for="CheckoutKey" type="hidden"/><label asp-for="Name">Họ tên</label><input asp-for="Name" autocomplete="name" required maxlength="100"/><label asp-for="Phone">Số điện thoại</label><input asp-for="Phone" autocomplete="tel" required/><label asp-for="Address">Địa chỉ</label><textarea asp-for="Address" autocomplete="street-address" required minlength="10" maxlength="300"></textarea><button>Đặt hàng</button><p class="muted">Thanh toán khi nhận hàng. Không có phí giao hàng trong bản demo.</p></form><section class="panel"><h2>Đơn hàng của bạn</h2>@foreach(var r in cart.Rows){<p>@r.Product.Name × @r.Quantity <strong>@r.Total.ToString("N0") ₫</strong></p>}<hr/><p>Tổng cộng <strong>@cart.Total.ToString("N0") ₫</strong></p></section></div>
