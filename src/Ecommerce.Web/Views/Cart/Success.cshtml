@model string
@{ ViewData["Title"]="Đặt hàng thành công"; ViewData["CategoryShop"]=true; }
<section class="container py-5 text-center">
    <i class="fa fa-check-circle-o" aria-hidden="true" style="font-size:48px;color:#555"></i>
    <h1 class="mt-3 mb-3">Đặt hàng thành công</h1>
    <p>Cảm ơn bạn đã mua sắm. Đơn hàng <strong>@Model</strong> đang chờ xử lý.</p>
    <div class="d-flex justify-content-center flex-wrap mt-4" style="gap:16px">
        <a class="primary-btn" asp-controller="Catalog" asp-action="Shop">Tiếp tục mua sắm</a>
        <a class="primary-btn" asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a>
    </div>
</section>
