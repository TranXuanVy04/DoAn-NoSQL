@model Product
@{ViewData["Title"]=Model.Name;}
<a asp-action="Index" class="back">← Tất cả sản phẩm</a><div class="detail-grid"><div class="product-art detail-art @Model.Kind" aria-hidden="true">@(Model.Kind=="electronics"?"◫":Model.Kind=="fashion"?"✦":"◒")</div><section><p class="eyebrow">@Model.Sku · @Model.Kind</p><h1>@Model.Name</h1><p class="price large">@Model.Price.ToString("N0") ₫</p><p>Còn @Model.Stock sản phẩm</p><dl>@foreach(var a in Model.Attributes){<dt>@a.Name</dt><dd>@a.Value</dd>}</dl><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id"/><label>Số lượng<input name="quantity" type="number" value="1" min="1" max="99"/></label><button disabled="@(Model.Stock==0)">Thêm vào giỏ hàng</button></form></section></div>
