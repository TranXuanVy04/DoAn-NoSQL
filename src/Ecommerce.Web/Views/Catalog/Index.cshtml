@model ProductPage
@{ViewData["Title"]="Khám phá sản phẩm"; var cats=(List<Category>)ViewBag.Categories;}
<section class="hero"><div><p class="eyebrow">MỘT ĐIỂM ĐẾN, NHIỀU LỰA CHỌN</p><h1>Những điều bạn cần,<br/>cho mỗi ngày.</h1><p>Tìm sản phẩm phù hợp từ điện tử, thời trang đến gia dụng.</p><a class="button" href="#products">Khám phá bộ sưu tập ↓</a></div><div class="hero-art" aria-hidden="true"><div>EC</div><span>Cho cuộc sống<br/>nhiều cảm hứng.</span></div></section>
<section id="products"><div class="section-head"><div><p class="eyebrow">CHỌN THEO CÁCH CỦA BẠN</p><h2>Tất cả sản phẩm</h2></div><span>@Model.Total sản phẩm</span></div>
<form method="get" class="filters"><label>Tìm kiếm<input name="q" value="@ViewBag.Query" placeholder="Tên sản phẩm…" maxlength="100"/></label><label>Danh mục<select name="categoryId"><option value="">Tất cả ngành hàng</option>@foreach(var c in cats){<option value="@c.Id" selected="@(c.Id==(string?)ViewBag.CategoryId)">@c.Name</option>}</select></label><button>Tìm sản phẩm</button><a asp-action="Index">Xóa lọc</a></form>
@if(Model.Items.Count==0){<div class="empty"><h3>Chưa có sản phẩm phù hợp</h3><p>Thử từ khóa hoặc danh mục khác.</p></div>}
<div class="grid">@foreach(var p in Model.Items){<article class="card"><a class="product-art @p.Kind" asp-action="Details" asp-route-id="@p.Id"><span aria-hidden="true">@(p.Kind=="electronics"?"◫":p.Kind=="fashion"?"✦":"◒")</span><small>@p.Kind</small></a><div class="card-body"><p class="eyebrow">@p.Sku</p><h3><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></h3><p class="price">@p.Price.ToString("N0") ₫</p><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@p.Id"/><button disabled="@(p.Stock==0)" class="outline">@(p.Stock==0?"Tạm hết hàng":"Thêm vào giỏ +")</button></form></div></article>}</div>
<nav class="pagination" aria-label="Phân trang">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-q="@ViewBag.Query" asp-route-categoryId="@ViewBag.CategoryId">← Trước</a>}<span>Trang @Model.Page / @Model.Pages</span>@if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)" asp-route-q="@ViewBag.Query" asp-route-categoryId="@ViewBag.CategoryId">Tiếp →</a>}</nav></section>
