@model ProductPage
@{
    ViewData["Title"] = "Cửa hàng";
    var categories = (List<Category>)ViewBag.Categories;
    bool isShop = ViewBag.IsShop == true || !string.IsNullOrWhiteSpace((string?)ViewBag.Query) || !string.IsNullOrEmpty((string?)ViewBag.CategoryId);
    bool showDemo = Model.Items.Count == 0 && !isShop;
    var products = showDemo ? StorefrontDemo.Products : Model.Items;
    ViewData["ImmersiveHome"] = !isShop;
    ViewData["CategoryShop"] = isShop;
    var selectedCategory = categories.FirstOrDefault(c => c.Id == (string?)ViewBag.CategoryId);
    var visibleCategories = categories.Where(c => c.ParentId == (string?)ViewBag.CategoryId).ToList();
}
<section class="hero ec-hero-section @(isShop ? "hero-normal" : "ec-immersive-hero")">
    <div class="container">
        @if (!isShop)
        {
			<div class="hero__item ec-home-banner">
                <video class="ec-hero-video" autoplay muted loop playsinline preload="auto" aria-label="Video bộ sưu tập">
                    <source src="/vendor/ogani/img/hero/1196-143842675.mp4" type="video/mp4" />
                </video>
                <div class="ec-hero-overlay"></div>
				<video controls="controls">
					<source src="~/vendor/ogani/img/hero/1196-143842675.mp4" type="video/mp4" />
				</video>
            </div>
        }
    </div>
</section>
@if (isShop)
{
    <section class="ec-shop-categories">
        <h1>@(selectedCategory?.Name ?? "Danh mục sản phẩm") <small>(@Model.Total sản phẩm)</small></h1>
        <div class="ec-category-grid">
            @foreach (var category in visibleCategories)
            {
                <a class="ec-category-tile" asp-action="Shop" asp-route-categoryId="@category.Id">
                    <div class="ec-category-art"><i class="fa @(category.Name.Contains("Điện") ? "fa-headphones" : category.Name.Contains("Thời") ? "fa-shopping-bag" : "fa-cube")" aria-hidden="true"></i></div>
                    <h2>@category.Name</h2>
                </a>
            }
        </div>
    </section>
}
<section class="featured spad @(!isShop ? "ec-collection-section" : "")" id="products">
    <div class="@(isShop ? "ec-products-content" : "container")">
            @if (!isShop)
            {
                <div class="section-title"><h2>Sản phẩm nổi bật</h2></div>
            }
            @if (products.Count == 0)
            { <div class="ec-empty"><i class="fa fa-search" aria-hidden="true"></i><h4>Chưa có sản phẩm phù hợp</h4><p>Hãy thử từ khóa hoặc danh mục khác.</p><a class="primary-btn" asp-action="Shop">XEM TẤT CẢ</a></div> }
            @if (showDemo) { <p class="ec-demo-note">Bộ sưu tập minh họa — nội dung sẽ được cập nhật.</p> }
            @if (isShop)
            {
            <div class="ec-list-toolbar">
                <button type="button" class="ec-filter-toggle" aria-expanded="false" aria-controls="product-filters">Sắp xếp và lọc <i class="fa fa-sliders" aria-hidden="true"></i></button>
            </div>
            <dialog id="product-filters" class="ec-filter-drawer" aria-labelledby="filter-title">
                <button type="button" class="ec-filter-close" aria-label="Đóng bộ lọc">&times;</button>
                <h2 id="filter-title">Sắp xếp và lọc</h2>
                <form asp-action="Shop" method="get" id="category-filter-form">
                    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Query)) { <input type="hidden" name="q" value="@ViewBag.Query" /> }
                    <details class="ec-filter-group" open>
                        <summary>Sắp xếp <span>Trên trang hiện tại</span></summary>
                        <label class="sr-only" for="page-sort">Sắp xếp sản phẩm</label>
                        <select id="page-sort"><option value="default">Mặc định</option><option value="asc">Tên A–Z</option><option value="desc">Tên Z–A</option></select>
                    </details>
                    <details class="ec-filter-group" open>
                        <summary>Danh mục</summary>
                        <label class="ec-filter-option"><input type="radio" name="categoryId" value="" checked="@(string.IsNullOrEmpty((string?)ViewBag.CategoryId))" />Tất cả danh mục</label>
                        @foreach (var category in categories)
                        {
                            <label class="ec-filter-option"><input type="radio" name="categoryId" value="@category.Id" checked="@(category.Id == (string?)ViewBag.CategoryId)" />@category.Name</label>
                        }
                    </details>
                    <div class="ec-filter-footer"><a asp-action="Shop">Xóa bộ lọc</a><button type="submit">Áp dụng</button></div>
                </form>
            </dialog>
            }
            <div class="ec-product-grid" aria-label="Danh sách sản phẩm">
                @foreach (var product in products)
                { <div class="ec-product-column" data-stock="@product.Stock" data-name="@product.Name"><partial name="_ProductCard" model="product" /></div> }
            </div>
            @if (!showDemo && Model.Pages > 1)
            {
                <nav class="product__pagination ec-pagination" aria-label="Phân trang">
                    @if (Model.Page > 1) { <a asp-action="@(isShop ? "Shop" : "Index")" asp-route-page="@(Model.Page - 1)" asp-route-q="@ViewBag.Query" asp-route-categoryId="@ViewBag.CategoryId" aria-label="Trang trước"><i class="fa fa-long-arrow-left" aria-hidden="true"></i></a> }
                    <span>Trang @Model.Page / @Model.Pages</span>
                    @if (Model.Page < Model.Pages) { <a asp-action="@(isShop ? "Shop" : "Index")" asp-route-page="@(Model.Page + 1)" asp-route-q="@ViewBag.Query" asp-route-categoryId="@ViewBag.CategoryId" aria-label="Trang tiếp"><i class="fa fa-long-arrow-right" aria-hidden="true"></i></a> }
                </nav>
            }
    </div>
</section>
