@model Order
@{ViewData["Title"]="Chi tiết đơn hàng";}
<p class="eyebrow">ĐƠN HÀNG</p><h1>@Model.Number</h1><p><span class="badge">@Model.Status</span> · @Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm") (UTC+7)</p><div class="panel"><h2>Người nhận</h2><p>@Model.Customer.Name · @Model.Customer.Phone</p><p>@Model.Customer.Address</p></div>
<div class="table-wrap"><table><caption>Thông tin và giá được lưu tại thời điểm đặt hàng</caption><thead><tr><th>Sản phẩm / thuộc tính lúc mua</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.Name</strong><p>@item.Sku · @item.CategoryName</p><p class="muted">@string.Join(" · ",item.Attributes.Select(x=>$"{x.Name}: {x.Value}"))</p></td><td>@item.UnitPrice.ToString("N0") ₫</td><td>@item.Quantity</td><td>@item.LineTotal.ToString("N0") ₫</td></tr>}</tbody><tfoot><tr><td colspan="3">Tổng cộng</td><td><strong>@Model.Total.ToString("N0") ₫</strong></td></tr></tfoot></table></div>
@if(User.Identity?.IsAuthenticated==true && Model.Status=="Pending"){<div class="actions"><form asp-controller="Admin" asp-action="OrderStatus" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="status" value="Completed"/><button>Hoàn tất đơn</button></form><form asp-controller="Admin" asp-action="OrderStatus" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="status" value="Cancelled"/><button class="danger">Hủy đơn & hoàn kho</button></form></div>}
