<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ecommerce-sv3-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="DotNetEnv" Version="3.2.0" /><PackageReference Include="MongoDB.Driver" Version="3.12.0" /></ItemGroup>
  <ItemGroup>
    <Content Remove=".env;.env.*" />
    <None Remove=".env;.env.*" />
    <None Include=".env" Condition="Exists('.env')" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Include=".env.example" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
