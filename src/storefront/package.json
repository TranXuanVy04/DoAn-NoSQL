{
  "name": "ecommerce-storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "contract:types": "openapi-typescript ../../contracts/openapi/ecommerce.v1.json -o src/shared/api/generated.d.ts",
    "contract:check": "npm run contract:types && git diff --exit-code -- src/shared/api/generated.d.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "^7.0.0"
  }
}
