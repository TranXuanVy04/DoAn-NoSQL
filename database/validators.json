{
  "danhmuc": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "name",
        "kind"
      ],
      "properties": {
        "_id": {
          "bsonType": "objectId"
        },
        "name": {
          "bsonType": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "electronics",
            "fashion",
            "home"
          ]
        }
      }
    }
  },
  "sanpham": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "sku",
        "name",
        "categoryId",
        "kind",
        "price",
        "stock",
        "isActive",
        "attributes"
      ],
      "properties": {
        "_id": {
          "bsonType": "objectId"
        },
        "sku": {
          "bsonType": "string",
          "minLength": 1
        },
        "name": {
          "bsonType": "string",
          "minLength": 1
        },
        "categoryId": {
          "bsonType": "objectId"
        },
        "kind": {
          "enum": [
            "electronics",
            "fashion",
            "home"
          ]
        },
        "price": {
          "bsonType": "long",
          "minimum": 1
        },
        "stock": {
          "bsonType": "int",
          "minimum": 0
        },
        "isActive": {
          "bsonType": "bool"
        },
        "attributes": {
          "bsonType": "object"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "electronics"
              ]
            },
            "attributes": {
              "bsonType": "object",
              "required": [
                "brand",
                "warrantyMonths"
              ],
              "properties": {
                "brand": {
                  "bsonType": "string"
                },
                "warrantyMonths": {
                  "bsonType": [
                    "int",
                    "long",
                    "double"
                  ],
                  "minimum": 0
                }
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "fashion"
              ]
            },
            "attributes": {
              "bsonType": "object",
              "required": [
                "size",
                "material"
              ],
              "properties": {
                "size": {
                  "bsonType": "string"
                },
                "material": {
                  "bsonType": "string"
                }
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "home"
              ]
            },
            "attributes": {
              "bsonType": "object",
              "required": [
                "material",
                "origin"
              ],
              "properties": {
                "material": {
                  "bsonType": "string"
                },
                "origin": {
                  "bsonType": "string"
                }
              }
            }
          }
        }
      ]
    }
  },
  "hoadon": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "_id",
        "number",
        "checkoutKey",
        "customerToken",
        "customer",
        "createdAt",
        "status",
        "items",
        "total"
      ],
      "properties": {
        "_id": {
          "bsonType": "objectId"
        },
        "number": {
          "bsonType": "string"
        },
        "checkoutKey": {
          "bsonType": "string"
        },
        "customerToken": {
          "bsonType": "string"
        },
        "customer": {
          "bsonType": "object",
          "required": [
            "name",
            "phone",
            "address"
          ],
          "properties": {
            "name": {
              "bsonType": "string"
            },
            "phone": {
              "bsonType": "string"
            },
            "address": {
              "bsonType": "string"
            }
          }
        },
        "createdAt": {
          "bsonType": "date"
        },
        "status": {
          "enum": [
            "Pending",
            "Completed",
            "Cancelled"
          ]
        },
        "items": {
          "bsonType": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "bsonType": "object",
            "required": [
              "productId",
              "sku",
              "name",
              "categoryName",
              "kind",
              "attributes",
              "unitPrice",
              "quantity",
              "lineTotal"
            ],
            "properties": {
              "productId": {
                "bsonType": "objectId"
              },
              "sku": {
                "bsonType": "string"
              },
              "name": {
                "bsonType": "string"
              },
              "categoryName": {
                "bsonType": "string"
              },
              "kind": {
                "bsonType": "string"
              },
              "attributes": {
                "bsonType": "object"
              },
              "unitPrice": {
                "bsonType": "long",
                "minimum": 1
              },
              "quantity": {
                "bsonType": "int",
                "minimum": 1,
                "maximum": 99
              },
              "lineTotal": {
                "bsonType": "long",
                "minimum": 1
              }
            }
          }
        },
        "total": {
          "bsonType": "long",
          "minimum": 1
        }
      }
    }
  }
}
